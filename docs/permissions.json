  "usage_examples": {
    "check_permission": {
      "description": "Yetki kontrolü yapma",
      "php": "if ($yetki->check('users', 'create')) { /* İşlem yapılabilir */ }",
      "javascript": "if (hasPermission('users', 'create')) { /* Butonu göster */ }"
    },
    "require_permission": {
      "description": "Yetki zorunluluğu",
      "php": "$yetki->require('dues', 'payment_create');",
      "javascript": "requirePermission('dues', 'payment_create');"
    },
    "multiple_permissions": {
      "description": "Çoklu yetki kontrolü",
      "php": "$yetki->checkAny(['dues.view', 'finance.income_view'])",
      "javascript": "hasPermission('dues', 'view') || hasPermission('finance', 'income_view')"
    }
  },
  "validation_rules": {
    "role_creation": {
      "required_fields": ["name", "permissions"],
      "name_min_length": 3,
      "name_max_length": 100,
      "permissions_format": "object",
      "valid_modules": ["users", "apartments", "dues", "finance", "roles"]
    },
    "permission_assignment": {
      "must_exist_in_system": true,
      "module_permission_validation": true,
      "prevent_self_role_removal": true,
      "admin_role_protection": true
    }
  }
}