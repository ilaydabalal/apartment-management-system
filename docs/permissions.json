{
  "system_modules": {
    "users": {
      "name": "Kullanıcı Yönetimi",
      "description": "Sistem kullanıcılarının yönetimi",
      "permissions": {
        "view": {
          "name": "Kullanıcıları görüntüleme",
          "description": "Kullanıcı listesini ve detaylarını görüntüleyebilir"
        },
        "create": {
          "name": "Kullanıcı ekleme",
          "description": "Yeni kullanıcı hesabı oluşturabilir"
        },
        "edit": {
          "name": "Kullanıcı düzenleme",
          "description": "Mevcut kullanıcı bilgilerini güncelleyebilir"
        },
        "delete": {
          "name": "Kullanıcı silme (pasifleştirme)",
          "description": "Kullanıcı hesabını pasifleştirebilir"
        }
      }
    },
    "apartments": {
      "name": "Apartman Yönetimi",
      "description": "Apartman ve daire bilgilerinin yönetimi",
      "permissions": {
        "view": {
          "name": "Apartman bilgilerini görüntüleme",
          "description": "Apartman listesi ve detaylarını görüntüleyebilir"
        },
        "create": {
          "name": "Apartman ekleme",
          "description": "Yeni apartman kaydı oluşturabilir"
        },
        "edit": {
          "name": "Apartman düzenleme",
          "description": "Apartman bilgilerini güncelleyebilir"
        },
        "delete": {
          "name": "Apartman silme (pasifleştirme)",
          "description": "Apartman kaydını pasifleştirebilir"
        }
      }
    },
    "dues": {
      "name": "Aidat ve Borç Yönetimi",
      "description": "Aidat belirleme, ödeme kayıtları ve borç takibi",
      "permissions": {
        "view": {
          "name": "Aidat bilgilerini görüntüleme",
          "description": "Aidat listesi ve detaylarını görüntüleyebilir"
        },
        "create": {
          "name": "Aidat belirleme",
          "description": "Yeni aidat tanımları oluşturabilir"
        },
        "edit": {
          "name": "Aidat düzenleme",
          "description": "Mevcut aidat bilgilerini güncelleyebilir"
        },
        "delete": {
          "name": "Aidat silme (pasifleştirme)",
          "description": "Aidat kaydını pasifleştirebilir"
        }
      }
    },
    "finance": {
      "name": "Gelir-Gider Takibi",
      "description": "Mali işlemler, raporlar ve kategori yönetimi",
      "permissions": {
        "income_view": {
          "name": "Gelir görüntüleme",
          "description": "Gelir kayıtlarını görüntüleyebilir"
        },
        "income_create": {
          "name": "Gelir ekleme",
          "description": "Yeni gelir kaydı oluşturabilir"
        },
        "income_edit": {
          "name": "Gelir düzenleme",
          "description": "Gelir kayıtlarını düzenleyebilir"
        },
        "expense_view": {
          "name": "Gider görüntüleme",
          "description": "Gider kayıtlarını görüntüleyebilir"
        },
        "expense_create": {
          "name": "Gider ekleme",
          "description": "Yeni gider kaydı oluşturabilir"
        },
        "expense_edit": {
          "name": "Gider düzenleme",
          "description": "Gider kayıtlarını düzenleyebilir"
        }
      }
    },
    "roles": {
      "name": "Yetki Grubu Yönetimi",
      "description": "Rol tanımlama ve yetki atama işlemleri",
      "permissions": {
        "view": {
          "name": "Rolleri görüntüleme",
          "description": "Yetki gruplarını ve detaylarını görüntüleyebilir"
        },
        "create": {
          "name": "Rol oluşturma",
          "description": "Yeni yetki grubu oluşturabilir"
        },
        "edit": {
          "name": "Rol düzenleme",
          "description": "Mevcut rolleri düzenleyebilir"
        },
        "delete": {
          "name": "Rol silme (pasifleştirme)",
          "description": "Rol kaydını pasifleştirebilir"
        }
      }
    }
  },
  "predefined_roles": {
    "super_admin": {
      "name": "Süper Admin",
      "description": "Tüm sistem yetkilerine sahip",
      "permissions": {
        "users": ["view", "create", "edit", "delete"],
        "apartments": ["view", "create", "edit", "delete"],
        "dues": ["view", "create", "edit", "delete", "payment_create"],
        "finance": ["income_view", "income_create", "income_edit", "expense_view", "expense_create", "expense_edit", "reports_view", "reports_export"],
        "roles": ["view", "create", "edit", "delete"]
      }
    },
    "accountant": {
      "name": "Muhasebeci",
      "description": "Mali işlemler yetkileri",
      "permissions": {
        "dues": ["view", "payment_create", "payment_edit", "debt_view"],
        "finance": ["income_view", "income_create", "income_edit", "expense_view", "expense_create", "expense_edit", "reports_view", "reports_export"]
      }
    }

  },
  "permission_groups": {
    "basic_view": {
      "name": "Temel Görüntüleme",
      "description": "Sadece listeleme ve görüntüleme yetkileri",
      "includes": ["view", "debt_view", "reports_view", "income_view", "expense_view"]
    },
    "basic_management": {
      "name": "Temel Yönetim",
      "description": "Görüntüleme + ekleme yetkileri",
      "includes": ["view", "create", "income_view", "income_create", "expense_view", "expense_create"]
    },
    "full_management": {
      "name": "Tam Yönetim",
      "description": "Tüm CRUD işlemleri",
      "includes": ["view", "create", "edit", "delete"]
    },
    "financial_management": {
      "name": "Mali Yönetim",
      "description": "Tüm mali işlemler",
      "includes": ["income_view", "income_create", "income_edit", "expense_view", "expense_create", "expense_edit", "reports_view", "reports_export"]
    }
  },
